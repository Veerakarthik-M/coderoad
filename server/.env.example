# ANAVANDI Server — Environment Variables
# Copy this file to .env and fill in real values

# ──────────────────────────────────────────────
# EMAIL (for OTP verification)
# ──────────────────────────────────────────────
# Without these, OTPs are printed to the server console only (demo mode)
#
# Step 1: Enable 2-Factor Authentication on your Gmail account
# Step 2: Go to Google Account → Security → 2-Step Verification → App Passwords
# Step 3: Create an app password for "Mail" → copy the 16-character code
#
# EMAIL_USER=yourapp@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx
# EMAIL_FROM="ANAVANDI" <yourapp@gmail.com>

# ──────────────────────────────────────────────
# JWT SECRET (change this in production!)
# ──────────────────────────────────────────────
# JWT_SECRET=change-this-to-a-long-random-string-in-production

# ──────────────────────────────────────────────
# PORT
# ──────────────────────────────────────────────
# PORT=3001
